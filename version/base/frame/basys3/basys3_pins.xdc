# Clocks made by the shell, and the clock of its input
# clock source clk_pin comes from shell.sys_clk: the shell's IP creates it, no create_clock is written here
# the clock of an input port of the shell, as the master has it (the shell's IP needs it)
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports clk]
