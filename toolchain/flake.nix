# DO NOT EDIT — generated by hw-proj from the isa: of the cores of the base and of every version, and libc: of firmware.yaml
# Regenerate with: hw-proj gen toolchain
# The firmware toolchains of the base and of every version, one package per isa (BUG-0128: nixpkgs' riscv64-none-elf-gcc has no rv32 runtime):
#   rv32imc_zicsr: riscv32-none-elf, -march=rv32imc_zicsr -mabi=ilp32, libc: none
# Build one from the repo root, into a git-ignored folder; nothing is installed in the system:
#   nix build path:./toolchain#rv32imc_zicsr --override-input nixpkgs nixpkgs -o .toolchain/rv32imc_zicsr
# gives .toolchain/<isa>/bin/<triple>-{gcc,as,ld,objcopy,objdump,...}. hw-proj finds the compiler there first.
# Not pinned: --override-input takes the machine's own nixpkgs (the registry id nixpkgs, the one its system was built from), so each machine
# builds from its own and finds its binary cache. To pin, run `nix flake lock path:./toolchain` and commit the flake.lock it writes (one lock for all packages); hw-proj then
# prints the build commands without --override-input. A pin is the global nixpkgs-unstable of that day: it may have no cache for the cross compiler.
{
  description = "firmware toolchains for isa rv32imc_zicsr";
  inputs.nixpkgs.url = "flake:nixpkgs";
  outputs = { self, nixpkgs }:
    let
      systems = [ "x86_64-linux" "aarch64-linux" ];
      toolchains = {
        "rv32imc_zicsr" = system:
          let
            host = import nixpkgs { inherit system; };
            cross = import nixpkgs {
              inherit system;
              crossSystem = { config = "riscv32-none-elf"; libc = "newlib"; gcc = { arch = "rv32imc_zicsr"; abi = "ilp32"; }; };
            };
            gcc = cross.buildPackages.gcc;
          in host.symlinkJoin {
            name = "rv32imc_zicsr-toolchain";
            paths = [ gcc ];
            # makeWrapper of the host set: the cross set's would build bash for the target
            nativeBuildInputs = [ host.makeWrapper ];
          };
      };
    in { packages = nixpkgs.lib.genAttrs systems (system: nixpkgs.lib.mapAttrs (_: build: build system) toolchains); };
}
